{
  "uid": "aegisops-overview",
  "title": "AegisOps AI Overview",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Incidents Created",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(aegisops_incidents_created_total)",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "RCA Requests",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(aegisops_rca_requests_total)",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
